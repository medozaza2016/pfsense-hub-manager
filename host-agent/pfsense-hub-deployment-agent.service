[Unit]
Description=pfSense Hub Manager restricted deployment agent
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0007
ExecStart=/usr/bin/python3 /usr/local/libexec/pfsense-hub-deployment-agent.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
