POSTGRES_DB=pfsense_hub
POSTGRES_USER=pfsense_hub
POSTGRES_PASSWORD=replace-with-a-long-random-password
# --- Legacy single-firewall bootstrap (existing installations only) ---
# A fresh Hub registers every firewall in Administration > Add Site, where the API key
# and CA certificate are stored per device; nothing below is required for a new install
# and no real firewall credential belongs in this file. These keys remain documented
# because an existing single-firewall deployment may still supply them, and they must be
# supplied as a complete set: a partial set fails configuration validation at startup.
# Remove this block only after that deployment has been migrated to GUI registration.
PFSENSE_DEVICE_ID=
PFSENSE_DEVICE_NAME=
PFSENSE_DEVICE_LOCATION=
PFSENSE_EDITION=unknown
PFSENSE_API_BASE_URL=
# CA bundle for the legacy bootstrap device only. Per-device TLS trust is configured in
# the GUI; the API does not read this file for GUI-registered sites.
PFSENSE_CA_FILE=
# Upstream read timeout, also used by GUI-registered sites.
PFSENSE_API_TIMEOUT_MS=10000
# Read-only site telemetry cache. A successful observation is reused briefly so
# navigating between site pages produces one upstream collection; a failed or
# partial observation is cached for a shorter time so recovery is noticed fast.
# Nothing is persisted; the cache is in-process only.
PFSENSE_OBSERVATION_CACHE_MS=10000
PFSENSE_OBSERVATION_ERROR_CACHE_MS=2000

# Background polling (DEC-043). Off by default: while the flag is false the API
# collects only when a site page is opened. When enabled, every enabled firewall
# is collected on the interval below with jitter and bounded backoff, and the
# poll history is pruned to the retention window. Exactly one API process may
# schedule; do not enable this on a second API replica.
PFSENSE_POLLING_ENABLED=false
# 15 s - 1 h.
PFSENSE_POLLING_INTERVAL_MS=60000
# 1 - 8 devices collected at the same time.
PFSENSE_POLLING_CONCURRENCY=2
# Random spread added to each poll; must be shorter than the interval.
PFSENSE_POLLING_JITTER_MS=15000
# 1 - 365 days of poll_runs history.
PFSENSE_POLLING_RETENTION_DAYS=30

# Linux production Host Agent integration. Keep the token private and use at least 32 random characters.
# Linux local development (install-linux.sh --local) and Windows 11 local development: leave token and socket empty.
HUB_AGENT_API_PORT=3001
HUB_DEPLOYMENT_AGENT_TOKEN=
HUB_DEPLOYMENT_AGENT_SOCKET=
HUB_AGENT_GID=2000
# Keep disabled until the Linux host integration tests have passed.
HUB_ACCESS_DEPLOYMENT_ENABLED=false

# System Monitoring & Recovery (docs/SYSTEM-MONITORING-RECOVERY.md). Both flags are
# fail-closed: monitoring exposes read-only host metrics, logs, and Compose
# validation; operations additionally allow admin-only start/stop/restart of the
# fixed Compose services and stack. Operations require monitoring.
HUB_HOST_MONITORING_ENABLED=false
HUB_HOST_OPERATIONS_ENABLED=false
HUB_HOST_OPERATION_TIMEOUT_MS=180000

# The web container defaults to loopback. The Linux host agent may change only this
# binding for LAN/Custom after validating the address and existing HTTPS endpoint.
# DNS, certificates, and reverse proxies remain operator-managed. Never use 0.0.0.0.
HUB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
