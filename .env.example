POSTGRES_DB=pfsense_hub
POSTGRES_USER=pfsense_hub
POSTGRES_PASSWORD=replace-with-a-long-random-password
PFSENSE_DEVICE_ID=00000000-0000-4000-8000-000000000001
PFSENSE_DEVICE_NAME=Primary pfSense Plus
PFSENSE_DEVICE_LOCATION=Primary site
PFSENSE_EDITION=plus
PFSENSE_API_BASE_URL=https://172.10.50.1:10443
PFSENSE_API_TIMEOUT_MS=10000

# Docker publishes the Hub web UI on exactly one host interface at a time.
# Keep the loopback default unless you deliberately apply a LAN, Tailscale,
# or Custom interface address assigned to the machine running Docker.
# The three Hub Settings tabs retain their own endpoint preferences, but
# selecting a tab does not itself rewrite this deployment setting or rebind
# the running container. Apply host changes deliberately, then recreate web.
# Never use 0.0.0.0 or another wildcard address.
HUB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# code-server is always published on loopback only.
CODE_SERVER_PORT=8443
PFSENSE_CA_FILE=
