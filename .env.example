POSTGRES_DB=pfsense_hub
POSTGRES_USER=pfsense_hub
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Leave the three legacy bootstrap fields blank to register firewalls in Administration > Add Site.
# API keys and optional CA certificates are entered in the GUI, not stored in .env.
PFSENSE_DEVICE_ID=
PFSENSE_DEVICE_NAME=
PFSENSE_DEVICE_LOCATION=
PFSENSE_EDITION=unknown
PFSENSE_API_BASE_URL=
PFSENSE_API_TIMEOUT_MS=10000

# Linux production Host Agent integration. Keep the token private and use at least 32 random characters.
# Linux local development (install-linux.sh --local) and Windows 11 local development: leave token and socket empty.
HUB_AGENT_API_PORT=3001
HUB_DEPLOYMENT_AGENT_TOKEN=
HUB_DEPLOYMENT_AGENT_SOCKET=
HUB_AGENT_GID=2000
# Keep disabled until the Linux host integration tests have passed.
HUB_ACCESS_DEPLOYMENT_ENABLED=false

# System Monitoring & Recovery (docs/SYSTEM-MONITORING-RECOVERY.md). Both flags are
# fail-closed: monitoring exposes read-only host metrics, logs, and Compose
# validation; operations additionally allow admin-only start/stop/restart of the
# fixed Compose services and stack. Operations require monitoring.
HUB_HOST_MONITORING_ENABLED=false
HUB_HOST_OPERATIONS_ENABLED=false
HUB_HOST_OPERATION_TIMEOUT_MS=180000

# The web container defaults to loopback. The Linux host agent may change only this
# binding for LAN/Custom after validating the address and existing HTTPS endpoint.
# DNS, certificates, and reverse proxies remain operator-managed. Never use 0.0.0.0.
HUB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

PFSENSE_CA_FILE=
